<Page x:Class="Atmos.Presentation.Features.Dashboard.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Atmos.Presentation.Features.Dashboard.Pages" 
      xmlns:viewmodels="clr-namespace:Atmos.Presentation.Features.Dashboard.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DashboardPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- Status text stretches -->
            <ColumnDefinition Width="Auto" />
            <!-- Button sizes to content -->
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Status}" 
               FontSize="20"
               VerticalAlignment="Center"
               Grid.Column="0"/>
        <Button Content="Disconnect"
            Command="{Binding DisconnectCommand}"
            BorderBrush="Black"
            BorderThickness="1"
            Grid.Column="1"
            VerticalAlignment="Center"
            Margin="10,0,0,0"/>
    </Grid>
</Page>
